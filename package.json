{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "Ecommerce platform built in React",
  "homepage": "https://github.com/ImageMagician/ecommerce-demo#readme",
  "bugs": {
    "url": "https://github.com/ImageMagician/ecommerce-demo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImageMagician/ecommerce-demo.git"
  },
  "license": "MIT",
  "author": "Mark Larson",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/seeder.js",
    "data:destroy": "node backend/seeder.js -d"
  },
  "overrides": {
    "braces": "^3.0.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0"
  },
  "devDependencies": {
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2"
  },
  "allowScripts": {
    "nodemon@1.19.4": true
  }
}
